# RunningHub API 配置
# 从 https://www.runninghub.cn API 控制台获取
RUNNINGHUB_API_KEY=your-32-char-api-key-here
RUNNINGHUB_WORKFLOW_ID=your-workflow-id-here
RUNNINGHUB_OOTD_WORKFLOW_ID=your-ootd-7day-workflow-id-here
RUNNINGHUB_QWEN_TRYON_WORKFLOW_ID=your-qwen-tryon-workflow-id-here
RUNNINGHUB_HD_RESTORE_WORKFLOW_ID=your-hd-restore-workflow-id-here
RUNNINGHUB_ANIMATE_TRANSFER_WORKFLOW_ID=your-animate-transfer-workflow-id-here
RUNNINGHUB_QWEN_PROMPT_IMAGE_WORKFLOW_ID=your-qwen-prompt-image-workflow-id-here
RUNNINGHUB_SCAIL_MULTI_REFERENCE_WORKFLOW_ID=your-scail-multi-reference-workflow-id-here
RUNNINGHUB_SCAIL_SEVEN_OUTFIT_WORKFLOW_ID=your-scail-seven-outfit-workflow-id-here
RUNNINGHUB_SCAIL_4K_POSE_BACKGROUND_WORKFLOW_ID=your-scail-4k-pose-background-workflow-id-here
RUNNINGHUB_KREA2_REALISTIC_4K_WORKFLOW_ID=your-krea2-realistic-4k-workflow-id-here
RUNNINGHUB_QWEN_MULTI_VIEW_WORKFLOW_ID=your-qwen-multi-view-workflow-id-here
QUEUE_TIMEOUT_SECONDS=86400
OOTD_WORKFLOW_TIMEOUT_SECONDS=7200

# API 基础地址 (默认国内)
RUNNINGHUB_BASE_URL=https://www.runninghub.cn

# 并发线程数 (消费级建议 3-5，企业级可设 10+)
RUNNINGHUB_MAX_WORKERS=5

# 轮询间隔 (秒)
RUNNINGHUB_POLL_INTERVAL=5

# 单个任务超时 (秒)
RUNNINGHUB_TASK_TIMEOUT=600

# GPU 实例保留时长 (秒, 10~180)
RUNNINGHUB_RETAIN_SECONDS=60

# 网络重试次数
RUNNINGHUB_MAX_RETRIES=3

# 输出目录
RUNNINGHUB_OUTPUT_DIR=./outputs

# 工作流 JSON 文件路径
RUNNINGHUB_WORKFLOW_JSON=动作迁移跳舞.json
